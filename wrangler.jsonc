{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": "commerce-testbed/backend/.worker-build/worker.py",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "commerce-testbed/frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/health",
      "/docs",
      "/docs/*",
      "/openapi.json",
      "/redoc"
    ],
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "846fc984bca949ccba191c6aa02e6c3b"
    }
  ],
  "build": {
    "command": "node scripts/prepare-deploy.mjs"
  }
}
